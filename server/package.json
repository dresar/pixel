{
  "name": "brevetai-backend",
  "version": "1.0.0",
  "private": true,
  "description": "BrevetAI Backend Server — Hono.js + Drizzle ORM + Neon PostgreSQL",
  "type": "module",
  "scripts": {
    "predev": "npx kill-port 3001",
    "dev": "tsx watch src/app.ts",
    "build": "node build.mjs",
    "start": "node app.js",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=drizzle.config.ts",
    "db:push": "drizzle-kit push --config=drizzle.config.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@hono/node-server": "^1.13.7",
    "@hono/zod-validator": "^0.4.1",
    "@neondatabase/serverless": "^1.1.0",
    "better-auth": "^1.6.25",
    "cloudinary": "^2.10.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.6.19",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.16.5",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.24.2",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3"
  }
}
