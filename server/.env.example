# BrevetAI Backend — Environment Variables
# Salin file ini ke .env dan isi nilai yang sesuai

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://neondb_owner:password@ep-xxxx.neon.tech/neondb?sslmode=require

# ─── Authentication ───────────────────────────────────────────────────────────
BETTER_AUTH_SECRET=ganti-dengan-secret-panjang-min-32-karakter
BASE_URL=http://localhost:3001

# ─── Frontend URL (untuk CORS) ─────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ─── Cloudinary ───────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Google Gemini AI ─────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash-lite

# ─── Security ─────────────────────────────────────────────────────────────────
API_KEY_ENCRYPTION_SECRET=ganti-dengan-secret-enkripsi-min-32-karakter

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
